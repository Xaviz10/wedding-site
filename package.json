{
  "name": "wedding-invitation-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:gallery": "vite --mode gallery-demo",
    "dev:gallery:network": "vite --mode gallery-demo --host 0.0.0.0",
    "qr:gallery:network": "node scripts/generate-gallery-phone-qr.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
