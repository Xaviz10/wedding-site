# URL publica de la aplicacion web de Google Apps Script. Debe terminar en /exec.
VITE_RSVP_ENDPOINT=

# URL base del API desplegado por CDK, sin slash final.
VITE_WEDDING_API_URL=

# URL publica completa del sitio, incluyendo /wedding-site.
VITE_WEBSITE_URL=

# Outputs AdminLoginDomain and AdminUserPoolClientId from the CDK stack.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Solo para desarrollo local. Nunca habilitar en un build publicado.
VITE_GALLERY_DEMO_MODE=false
